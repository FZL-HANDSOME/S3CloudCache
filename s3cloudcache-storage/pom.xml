<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- 中文：继承 1.0-SNAPSHOT 父工程及统一日志约定；此模块组合 WAL、核心缓存与 S3 接口。
         English: Inherits the 1.0-SNAPSHOT parent and shared logging conventions; this module combines WAL, the cache core, and S3 integration. -->
    <parent>
        <groupId>org.example</groupId>
        <artifactId>S3CloudCache</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <!-- 中文：目录名为 s3cloudcache-storage，对外 Maven artifactId 为 s3cloudcache-instance，消费者按后者引用。
         English: The directory is s3cloudcache-storage, but its published Maven artifactId is s3cloudcache-instance, which consumers reference. -->
    <artifactId>s3cloudcache-instance</artifactId>

    <!-- 中文：源码和生成字节码均为 Java 25；UTF-8 保留双语说明，编译环境需支持此目标。
         English: Source and generated bytecode target Java 25; UTF-8 preserves bilingual text, and the compiler must support this target. -->
    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 中文：JUnit 4.13.2 为 test 范围，运行隔离的故障回归，不要求生产用户安装测试框架。
             English: JUnit 4.13.2 has test scope for isolated fault regressions; production consumers do not need the test framework. -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <!-- 公共 API：配置(S3CloudCacheConfig/BucketConfig)、WriteResult、枚举等，对使用者可见 -->
        <!-- 中文：common 1.0-SNAPSHOT 保持默认 compile 传递性且不被下方 shade 合并，以保留公开类型身份。
             English: common 1.0-SNAPSHOT retains default compile transitivity and is not merged by shade, preserving public type identity. -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>s3cloudcache-common</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- AWS S3 SDK：公共 API 需要 S3Client，对使用者可见 -->
        <!-- 中文：S3 SDK 固定 2.25.53，作为公共构造参数和 API 使用的默认 compile 依赖保留在外部。
             English: S3 SDK 2.25.53 remains an external default-compile dependency used by public constructor arguments and APIs. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>2.25.53</version>
        </dependency>

        <!-- 默认 HTTP 客户端：S3ClientFactory 内部构建 S3Client 需要，运行时可见 -->
        <!-- 中文：URL Connection 客户端与 S3 SDK 使用同一版本 2.25.53；此节点未声明 scope，因此采用 compile 范围。
             English: The URL Connection client matches S3 SDK version 2.25.53; no scope is declared, so compile scope applies. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
            <version>2.25.53</version>
        </dependency>

        <!-- ================================================================== -->
        <!-- 内部实现模块：项目内（reactor/IDEA）正常传递，供同项目的测试模块使用。    -->
        <!-- 对外发布时由 maven-shade-plugin 打进本 jar 并重定位到 internal 包，        -->
        <!-- 再通过 dependency-reduced-pom 从对外 pom 中移除，不传递给外部使用者。      -->
        <!-- ================================================================== -->
        <dependency>
            <groupId>org.example</groupId>
            <!-- 中文：core 1.0-SNAPSHOT 提供物理缓存和上传执行，默认 compile 范围供 reactor 直接使用。
                 English: core 1.0-SNAPSHOT provides the physical cache and upload execution with default compile scope inside the reactor. -->
            <artifactId>s3cloudcache-core</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <!-- 中文：wal 1.0-SNAPSHOT 提供日志映射与恢复源，包产物阶段列入内部合并范围。
                 English: wal 1.0-SNAPSHOT provides mapped logs and recovery sources and is included in internal merging at package time. -->
            <artifactId>s3cloudcache-wal</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <!-- 中文：metadata 1.0-SNAPSHOT 共享提交状态；其包与其它内部模块一起重定位。
                 English: metadata 1.0-SNAPSHOT shares commit state; its packages are relocated with the other internal modules. -->
            <artifactId>s3cloudcache-metadata</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 将内部实现模块(core/wal/metadata)打进 s3cloudcache-instance 的 jar，
                 并重定位到 org.foreverfzl.cloudcache.internal.* 包，实现对外黑盒。
                 公共 API(common) 与 AWS SDK 保持外部依赖，不打进 jar。 -->
            <plugin>
                <!-- 中文：shade 3.5.1 仅在 package 阶段执行；测试与 reactor 编译仍使用原始模块布局。
                     English: shade 3.5.1 runs only during package; tests and reactor compilation still use the original module layout. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <dependencies>
                    <!-- 中文：这些 ASM 9.8 依赖属于 Maven 插件类加载空间，用于读取和重写字节码，不是应用运行时依赖。
                         English: These ASM 9.8 dependencies belong to the Maven plugin classloader for bytecode reading and rewriting, not the application's runtime dependencies. -->
                    <!-- 覆盖 shade 插件自带的 ASM，升级到 9.8 以支持 Java 25(class file 69) -->
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>9.8</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-commons</artifactId>
                        <version>9.8</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-tree</artifactId>
                        <version>9.8</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-analysis</artifactId>
                        <version>9.8</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- 中文：白名单仅合并 core、wal、metadata；不把 common、AWS SDK 或测试库整体打入公开 jar。
                                 English: The allowlist merges only core, wal, and metadata; common, the AWS SDK, and test libraries are not bundled wholesale. -->
                            <artifactSet>
                                <includes>
                                    <include>org.example:s3cloudcache-core</include>
                                    <include>org.example:s3cloudcache-wal</include>
                                    <include>org.example:s3cloudcache-metadata</include>
                                </includes>
                            </artifactSet>
                            <!-- 内部实现包重定位，避免使用者直接引用 -->
                            <!-- 中文：重定位的是内部实现包名，不改变 common 中公开配置和结果类型的包名。
                                 English: Relocation changes internal implementation package names, not public configuration and result packages in common. -->
                            <relocations>
                                <relocation>
                                    <pattern>org.foreverfzl.cloudcache.core</pattern>
                                    <shadedPattern>org.foreverfzl.cloudcache.internal.core</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.foreverfzl.cloudcache.wal</pattern>
                                    <shadedPattern>org.foreverfzl.cloudcache.internal.wal</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.foreverfzl.cloudcache.metadata</pattern>
                                    <shadedPattern>org.foreverfzl.cloudcache.internal.metadata</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
